{
  "id": "adsb-lol",
  "name": "adsb.lol military aircraft",
  "description": "Worked example: HTTP polling, one response split into many records, unit transforms (knots, feet, ft/min), ICAO identifiers and country-based affiliation.",
  "transport": {
    "type": "http_poll",
    "url": "https://api.adsb.lol/v2/mil",
    "interval_secs": 5,
    "timeout_secs": 20
  },
  "pipeline": {
    "codec": {
      "type": "json",
      "records": "ac",
      "context": [
        "now"
      ]
    },
    "mapping": {
      "schema_version": 2,
      "rules": [
        {
          "name": "static",
          "kind": "static",
          "key": {
            "path": "hex",
            "transforms": [
              "string",
              "trim",
              "lower",
              "nonempty"
            ]
          },
          "fields": {
            "callsign": {
              "path": "flight",
              "transforms": [
                "trim",
                "nonempty"
              ]
            },
            "platform.type_code": {
              "path": "t",
              "transforms": [
                "trim",
                "nonempty"
              ]
            },
            "ext.registration": {
              "path": "r",
              "transforms": [
                "trim",
                "nonempty"
              ]
            },
            "ext.category": {
              "path": "category",
              "transforms": [
                "trim",
                "nonempty"
              ]
            }
          }
        },
        {
          "name": "position",
          "when": {
            "all": [
              {
                "path": "lat",
                "exists": true
              },
              {
                "path": "lon",
                "exists": true
              }
            ]
          },
          "key": {
            "path": "hex",
            "transforms": [
              "string",
              "trim",
              "lower",
              "nonempty"
            ]
          },
          "identifiers": [
            {
              "scheme": "icao",
              "value": {
                "path": "hex",
                "transforms": [
                  "string",
                  "trim",
                  "lower",
                  "nonempty"
                ]
              }
            }
          ],
          "fields": {
            "position.latitude": {
              "path": "lat",
              "range": [
                -90,
                90
              ]
            },
            "position.longitude": {
              "path": "lon",
              "range": [
                -180,
                180
              ]
            },
            "position.altitude_hae_m": {
              "first": [
                {
                  "cases": [
                    {
                      "when": {
                        "path": "alt_baro",
                        "eq": "ground"
                      },
                      "then": {
                        "const": 0
                      }
                    }
                  ]
                },
                {
                  "path": "alt_geom",
                  "transforms": [
                    "feet_to_m"
                  ]
                },
                {
                  "path": "alt_baro",
                  "transforms": [
                    "feet_to_m"
                  ]
                }
              ]
            },
            "observed_at": {
              "first": [
                {
                  "arith": "sub",
                  "args": [
                    {
                      "path": "_frame.now",
                      "transforms": [
                        "scale:0.001"
                      ]
                    },
                    {
                      "path": "seen_pos",
                      "range": [
                        0,
                        1000000000.0
                      ]
                    }
                  ]
                },
                {
                  "path": "_frame.now",
                  "transforms": [
                    "scale:0.001"
                  ]
                }
              ],
              "transforms": [
                "time_unix_s"
              ]
            },
            "kinematics.course_deg": {
              "path": "track",
              "range": [
                0,
                359.9999
              ]
            },
            "kinematics.speed_mps": {
              "path": "gs",
              "transforms": [
                "knots_to_mps"
              ]
            },
            "kinematics.heading_deg": {
              "first": [
                "true_heading",
                "mag_heading"
              ],
              "range": [
                0,
                359.9999
              ]
            },
            "kinematics.vertical_rate_mps": {
              "first": [
                "geom_rate",
                "baro_rate"
              ],
              "transforms": [
                "fpm_to_mps"
              ]
            },
            "uncertainty.circular_error_m": "rc",
            "uncertainty.vertical_error_m": {
              "path": "gva",
              "table": {
                "1": 150.0,
                "2": 45.0
              }
            },
            "callsign": {
              "path": "flight",
              "transforms": [
                "trim",
                "nonempty"
              ]
            },
            "platform.type_code": {
              "path": "t",
              "transforms": [
                "trim",
                "nonempty"
              ]
            },
