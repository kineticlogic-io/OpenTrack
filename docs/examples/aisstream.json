{
  "id": "aisstream",
  "name": "aisstream.io (worldwide AIS)",
  "description": "Worked example: WebSocket with subscribe-on-connect, AIS static join, registry lookup by MMSI, military-only filter, throttling.",
  "transport": {
    "type": "websocket",
    "url": "wss://stream.aisstream.io/v0/stream",
    "subscribe": {
      "APIKey": "${env:AISSTREAM_API_KEY}",
      "BoundingBoxes": [
        [
          [
            -90,
            -180
          ],
          [
            90,
            180
          ]
        ]
      ],
      "FilterMessageTypes": [
        "PositionReport",
        "StandardClassBPositionReport",
        "ExtendedClassBPositionReport",
        "ShipStaticData",
        "StaticDataReport"
      ]
    },
    "error_path": "error",
    "ping_secs": 20
  },
  "pipeline": {
    "codec": {
      "type": "json"
    },
    "mapping": {
      "schema_version": 2,
      "reject": [
        {
          "reason": "distress beacon",
          "when": {
            "value": {
              "first": [
                "Message.PositionReport.UserID",
                "Message.StandardClassBPositionReport.UserID",
                "Message.ExtendedClassBPositionReport.UserID",
                "Message.ShipStaticData.UserID",
                "Message.StaticDataReport.UserID",
                "MetaData.MMSI"
              ],
              "transforms": [
                "string"
              ]
            },
            "matches": "^97[024]\\d{6}$"
          }
        },
        {
          "reason": "malformed MMSI",
          "when": {
            "not": {
              "value": {
                "first": [
                  "Message.PositionReport.UserID",
                  "Message.StandardClassBPositionReport.UserID",
                  "Message.ExtendedClassBPositionReport.UserID",
                  "Message.ShipStaticData.UserID",
                  "Message.StaticDataReport.UserID",
                  "MetaData.MMSI"
                ],
                "transforms": [
                  "string"
                ]
              },
              "matches": "^\\d{9}$"
            }
          }
        },
        {
          "reason": "placeholder MMSI",
          "when": {
            "value": {
              "first": [
                "Message.PositionReport.UserID",
                "Message.StandardClassBPositionReport.UserID",
                "Message.ExtendedClassBPositionReport.UserID",
                "Message.ShipStaticData.UserID",
                "Message.StaticDataReport.UserID",
                "MetaData.MMSI"
              ],
              "transforms": [
                "string"
              ]
            },
            "in": [
              "123456789",
              "000000000",
              "111111111"
            ]
          }
        },
        {
          "reason": "unallocated MID",
          "when": {
            "not": {
              "value": {
                "first": [
                  "Message.PositionReport.UserID",
                  "Message.StandardClassBPositionReport.UserID",
                  "Message.ExtendedClassBPositionReport.UserID",
                  "Message.ShipStaticData.UserID",
                  "Message.StaticDataReport.UserID",
                  "MetaData.MMSI"
                ],
                "transforms": [
                  "string",
                  "regex:^(?:111(\\d{3})|00(\\d{3})|98(\\d{3})|99(\\d{3})|0(\\d{3})|8(\\d{3})|(\\d{3}))",
                  "number"
                ]
              },
              "gte": 201,
              "lte": 775
            }
          }
        },
        {
          "reason": "denylisted MMSI",
          "when": {
            "value": {
              "first": [
                "Message.PositionReport.UserID",
                "Message.StandardClassBPositionReport.UserID",
                "Message.ExtendedClassBPositionReport.UserID",
                "Message.ShipStaticData.UserID",
                "Message.StaticDataReport.UserID",
                "MetaData.MMSI"
              ],
              "transforms": [
                "string"
              ]
            },
            "in": [
              "219031279",
              "222123126",
              "227000000"
            ]
          }
        }
      ],
      "rules": [
        {
          "name": "static",
          "kind": "static",
          "when": {
            "path": "MessageType",
            "in": [
              "ShipStaticData",
              "ExtendedClassBPositionReport"
            ]
          },
          "let": {
            "_body": {
              "path": "Message",
              "key": "MessageType"
            }
          },
          "key": {
            "first": [
              "Message.PositionReport.UserID",
              "Message.StandardClassBPositionReport.UserID",
              "Message.ExtendedClassBPositionReport.UserID",
              "Message.ShipStaticData.UserID",
              "Message.StaticDataReport.UserID",
              "MetaData.MMSI"
            ],
            "transforms": [
              "string"
            ]
          },
          "fields": {
            "name": {
              "path": "_body.Name",
              "transforms": [
                "string",
                "replace:@: ",
                "trim",
                "nonempty"
              ]
            },
            "callsign": {
              "path": "_body.CallSign",
              "transforms": [
                "string",
                "replace:@: ",
                "trim",
                "nonempty"
              ]
            },
            "platform.type_code": {
              "path": "_body.Type",
              "null_if": [
                0
              ],
              "transforms": [
                "string"
              ]
            },
            "classification.cot_type": {
