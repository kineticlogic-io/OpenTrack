              "transforms": [
                "string",
                "replace:@: ",
                "trim",
                "nonempty"
              ]
            },
            "ext.length_m": {
              "arith": "add",
              "args": [
                "_body.Dimension.A",
                "_body.Dimension.B"
              ]
            },
            "ext.beam_m": {
              "arith": "add",
              "args": [
                "_body.Dimension.C",
                "_body.Dimension.D"
              ]
            }
          },
          "identifiers": [
            {
              "scheme": "imo",
              "value": {
                "path": "_body.ImoNumber",
                "null_if": [
                  0
                ],
                "transforms": [
                  "string"
                ]
              }
            }
          ]
        },
        {
          "name": "static-24",
          "kind": "static",
          "when": {
            "path": "MessageType",
            "eq": "StaticDataReport"
          },
          "key": {
            "first": [
              "Message.PositionReport.UserID",
              "Message.StandardClassBPositionReport.UserID",
              "Message.ExtendedClassBPositionReport.UserID",
              "Message.ShipStaticData.UserID",
              "Message.StaticDataReport.UserID",
              "MetaData.MMSI"
            ],
            "transforms": [
              "string"
            ]
          },
          "fields": {
            "name": {
              "cases": [
                {
                  "when": {
                    "path": "Message.StaticDataReport.ReportA.Valid",
                    "eq": true
                  },
                  "then": {
                    "path": "Message.StaticDataReport.ReportA.Name",
                    "transforms": [
                      "string",
                      "replace:@: ",
                      "trim",
                      "nonempty"
                    ]
                  }
                }
              ]
            },
            "callsign": {
              "cases": [
