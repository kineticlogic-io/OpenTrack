<STIG_DATA><VULN_ATTRIBUTE>STIG_UUID</VULN_ATTRIBUTE><ATTRIBUTE_DATA>4bb4bb69-ac34-5cad-97bd-692cd86cae08</ATTRIBUTE_DATA></STIG_DATA>
<STIG_DATA><VULN_ATTRIBUTE>CCI_REF</VULN_ATTRIBUTE><ATTRIBUTE_DATA>CCI-000131</ATTRIBUTE_DATA></STIG_DATA>
<STATUS>NotAFinding</STATUS><FINDING_DETAILS>Each audit row carries at_ms, a UTC millisecond timestamp (crates/ot-store/src/sqlite.rs now_ms), included in the hash chain; exported log records carry the timestamp (docs/guides/admin.md#audit-record).</FINDING_DETAILS><COMMENTS></COMMENTS><SEVERITY_OVERRIDE></SEVERITY_OVERRIDE><SEVERITY_JUSTIFICATION></SEVERITY_JUSTIFICATION>
</VULN>
<VULN>
<STIG_DATA><VULN_ATTRIBUTE>Vuln_Num</VULN_ATTRIBUTE><ATTRIBUTE_DATA>V-233044</ATTRIBUTE_DATA></STIG_DATA>
