                  "when": {
                    "path": "Message.StaticDataReport.ReportB.Valid",
                    "eq": true
                  },
                  "then": {
                    "path": "Message.StaticDataReport.ReportB.CallSign",
                    "transforms": [
                      "string",
                      "replace:@: ",
                      "trim",
