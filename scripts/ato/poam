#!/usr/bin/env python3
"""Render the POA&M (docs/security/ato/poam.json) as poam.md and poam.csv (the
DoD POA&M template's columns, for eMASS). Standard library only.
Usage: scripts/ato/poam"""
import csv, json, pathlib
ATO = pathlib.Path(__file__).resolve().parents[2] / "docs/security/ato"
items = json.loads((ATO / "poam.json").read_text())
TARGET = {"0.4.x": "Next 0.4 release", "0.5.0": "0.5.0", "decision": "Product owner decision", "accepted": "Risk accepted"}
md = ["# Plan of Action and Milestones", "",
      "Every open finding in the package: checklist items (`checklists/summary.md`), partially implemented",
      "controls (`ssp-narratives.md`) and image scan findings (`scans/`). Generated by `scripts/ato/poam` from",
      "`poam.json`; `poam.csv` has the DoD POA&M template's columns for eMASS. Scheduled completion dates",
      "are the product owner's to set: `[[DATE]]`. A site adds its own items.", "",
      "| ID | Severity | Weakness | Controls | Source | Remediation | Target |", "|---|---|---|---|---|---|---|"]
for i in items:
    md.append(f"| {i['id']} | {i['severity']} | {i['weakness']} | {i['controls']} | {i['checks']} | {i['remediation']} | {TARGET[i['target']]} |")
(ATO / "poam.md").write_text("\n".join(md) + "\n")
cols = ["POA&M Item ID", "Control Vulnerability Description", "Security Control Number (NC/NA controls only)", "Office/Org",
        "Security Checks", "Resources Required", "Scheduled Completion Date", "Milestone with Completion Dates",
        "Milestone Changes", "Source Identifying Control Vulnerability", "Status", "Comments", "Raw Severity", "Mitigations",
        "Severity", "Recommendations"]
with open(ATO / "poam.csv", "w", newline="") as f:
    w = csv.writer(f)
    w.writerow(cols)
    for i in items:
        src = "STIG checklist" if ("V-" in i["checks"]) else ("Vulnerability scan" if "scan" in i["checks"] else "SSP / control mapping")
        w.writerow([i["id"], i["weakness"], i["controls"], "OpenTrack product team", i["checks"], "Development team",
                    "[[DATE]]", f"{TARGET[i['target']]}: {i['remediation']} [[DATE]]", "", src, "Ongoing", "",
                    {"CAT I": "I", "CAT II": "II", "CAT III": "III"}[i["severity"]], "", {"CAT I": "High", "CAT II": "Moderate", "CAT III": "Low"}[i["severity"]],
                    i["remediation"]])
print(f"poam.md, poam.csv: {len(items)} items")
