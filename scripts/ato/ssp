#!/usr/bin/env python3
"""Render the SSP control narratives (docs/security/ato/ssp/controls.json, one
entry per NIST SP 800-53 Rev 5 Moderate control) as
docs/security/ato/ssp-narratives.md, for the accreditation package
(docs/security/ato/README.md). The JSON is the source of truth, reviewed like
code. Standard library only.

Usage: scripts/ato/ssp
"""

import collections
import json
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parents[2]
ATO = ROOT / "docs/security/ato"
STATUSES = ("Implemented", "Partially implemented", "Planned", "Inherited", "Not applicable")
RESPONSIBILITY = ("OpenTrack", "Shared", "Site")
FAMILIES = {
    "ac": "Access Control", "at": "Awareness and Training", "au": "Audit and Accountability",
    "ca": "Assessment, Authorization, and Monitoring", "cm": "Configuration Management",
    "cp": "Contingency Planning", "ia": "Identification and Authentication", "ir": "Incident Response",
    "ma": "Maintenance", "mp": "Media Protection", "pe": "Physical and Environmental Protection",
    "pl": "Planning", "ps": "Personnel Security", "ra": "Risk Assessment",
    "sa": "System and Services Acquisition", "sc": "System and Communications Protection",
    "si": "System and Information Integrity", "sr": "Supply Chain Risk Management",
}


def label(cid):
    """`ac-2.3` as `AC-2(3)`."""
    fam, _, rest = cid.partition("-")
    num, _, enh = rest.partition(".")
    return f"{fam.upper()}-{num}" + (f"({enh})" if enh else "")


def order(cid):
    fam, _, rest = cid.partition("-")
    num, _, enh = rest.partition(".")
    return (fam, int(num), int(enh or 0))


def main():
    controls = json.loads((ATO / "ssp/controls.json").read_text())
    bad = [c["id"] for c in controls
           if c.get("status") not in STATUSES or c.get("responsibility") not in RESPONSIBILITY or not c.get("narrative")]
    if bad:
        sys.exit(f"bad status, responsibility or narrative: {', '.join(bad[:10])}")
    controls.sort(key=lambda c: order(c["id"]))
    by_fam = collections.defaultdict(list)
    for c in controls:
        by_fam[c["id"].split("-")[0]].append(c)

    out = [
        "# System Security Plan: control narratives",
        "",
        "OpenTrack 0.4.x against the NIST SP 800-53 Rev 5 **Moderate** baseline (287 controls), for an",
        "adopting site's SSP. Generated by `scripts/ato/ssp` from `ssp/controls.json`; edit the JSON, not",
        "this file. `[[SITE: ...]]` marks what the site fills in (system name, boundary, organisation-",
        "defined parameters). **Status** is for OpenTrack's part; **Responsibility** says who meets it:",
        "OpenTrack (the product), Shared (product and site) or Site (hosting, platform, organisation).",
        "",
        "## Summary",
        "",
        "| Family | Controls | Implemented | Partially | Planned | Inherited | N/A |",
        "|---|---|---|---|---|---|---|",
    ]
    for fam, cs in by_fam.items():
        n = collections.Counter(c["status"] for c in cs)
        out.append(f"| {fam.upper()} {FAMILIES[fam]} | {len(cs)} | {n['Implemented']} | {n['Partially implemented']} | "
                   f"{n['Planned']} | {n['Inherited']} | {n['Not applicable']} |")
    total = collections.Counter(c["status"] for c in controls)
    out.append(f"| **All** | {len(controls)} | {total['Implemented']} | {total['Partially implemented']} | "
               f"{total['Planned']} | {total['Inherited']} | {total['Not applicable']} |")
    gaps = [c for c in controls if c["status"] in ("Partially implemented", "Planned")]
    out += ["", "Partially implemented and planned controls are on the POA&M (`poam.md`):", ""]
    out += [f"- **{label(c['id'])}** {c['title']}: {c['status'].lower()}." for c in gaps] or ["- none"]

    for fam, cs in by_fam.items():
        out += ["", f"## {fam.upper()}: {FAMILIES[fam]}"]
        for c in cs:
            out += ["", f"### {label(c['id'])} {c['title']}", "",
                    f"**Status:** {c['status']} · **Responsibility:** {c['responsibility']}", "", c["narrative"]]
            if c.get("evidence"):
                out += ["", f"*Evidence:* {c['evidence']}"]
            if c.get("site"):
                out += ["", f"*Site:* {c['site']}"]
    (ATO / "ssp-narratives.md").write_text("\n".join(out) + "\n")
    print(f"ssp-narratives.md: {len(controls)} controls ({dict(total)})")


if __name__ == "__main__":
    main()
